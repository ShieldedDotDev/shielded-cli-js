{
    "name": "shielded-cli",
    "version": "0.3.0",
    "description": "Shielded.dev JS SDK",
    "main": "dist/sdk.js",
    "scripts": {
        "test": "node --test test/*.test.cjs",
        "build": "tsc && chmod +x dist/bin.js",
        "lint": "oxlint src test",
        "format": "oxfmt --ignore-path .oxfmtignore --write src test",
        "format:check": "oxfmt --ignore-path .oxfmtignore --check src test"
    },
    "author": {
        "name": "Jesse G. Donat",
        "email": "donatj@gmail.com",
        "url": "https://donatstudios.com"
    },
    "license": "MIT",
    "homepage": "https://github.com/ShieldedDotDev/shielded-cli-js",
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/node-fetch": "^2.6.2",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "typescript": "^5.9.3"
    },
    "bin": {
        "shielded": "dist/bin.js"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "node-fetch": "^2.6.13"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
